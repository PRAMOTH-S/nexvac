<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nexva_coverage</name>
  <version>0.1.0</version>
  <description>
    Boustrophedon coverage path planning for the Nexva vacuum robot. Adapted
    from oomwoo_coverage (Copyright 2026 Jayadev Rana, Apache-2.0): the Gazebo
    bumper dependency was made optional and the defaults retuned for Nexva's
    footprint and velocity limits. Drives the existing Nav2 stack via
    NavigateToPose; it does not replace navigation.
  </description>
  <maintainer email="pramothsekar@gmail.com">PRAMOTH-S</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!-- vacuum.launch.py starts the web bridge too -->
  <exec_depend>nexva_web</exec_depend>
  <!-- ros_gz_interfaces is deliberately NOT a dependency: it only provides the
       Gazebo bumper message, and Nexva has no bumpers. The node imports it
       optionally and runs without it. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
