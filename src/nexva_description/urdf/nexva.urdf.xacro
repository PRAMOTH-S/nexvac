<?xml version="1.0" ?>
<robot name="nexva" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find nexva_description)/urdf/materials.xacro" />
<xacro:include filename="$(find nexva_description)/urdf/nexva.gazebo" />



  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>

    <!-- The meshes and wheel joints were authored with the robot driving along
         an axis that is not +X (both wheels sit at x = +-0.12, so the axle
         runs along X). ROS expects +X forward, so base_link is yawed here to
         correct it: -90 deg squared the model up, plus a further 180 deg to
         face it the right way round, giving +90 deg total. -->
    <origin xyz="0 0 0" rpy="0 0 1.5708"/>
  </joint>



<link name="base_link">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="6.743767331968088"/>
    <inertia ixx="0.040343" iyy="0.056755" izz="0.029008" ixy="1.8e-05" iyz="1e-05" ixz="-0.0"/>
  </inertial>
  <!-- The STLs were exported Y-up (base_link.stl measures 0.270 x 0.145 x
       0.270, so its thin axis is Y). ROS is Z-up, so the mesh is rolled +90
       deg about X here. The wheel joints already do this via their own rpy. -->
  <visual>
    <origin xyz="0 0 0.07" rpy="1.5708 0 0"/>
    <geometry>
      <mesh filename="package://nexva_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="green"/>
  </visual>
  <collision>
    <origin xyz="0 0 0.07" rpy="1.5708 0 0"/>
    <geometry>
      <mesh filename="package://nexva_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="laser">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="0.6304727152144582"/>
    <inertia ixx="0.000197" iyy="0.000327" izz="0.000196" ixy="-0.0" iyz="0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 -0.087" rpy="1.5708 0 0"/>
    <geometry>
      <mesh filename="package://nexva_description/meshes/lidar_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="blue"/>
  </visual>
  <collision>
    <origin xyz="0 0 -0.087" rpy="1.5708 0 0"/>
    <geometry>
      <mesh filename="package://nexva_description/meshes/lidar_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="left_wheel_1">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="0.3599022494580457"/>
    <inertia ixx="0.000222" iyy="0.000127" izz="0.000118" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://nexva_description/meshes/left_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="black"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://nexva_description/meshes/left_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<link name="right_wheel_1">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="0.3599022494580457"/>
    <inertia ixx="0.000222" iyy="0.000127" izz="0.000118" ixy="-0.0" iyz="-0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://nexva_description/meshes/right_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="black"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://nexva_description/meshes/right_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="lidar_joint" type="fixed">
  <!-- 0.157 puts the scanner flush on the chassis top: the body reaches
       z=0.1445 and lidar_1.stl carries a baked 0.087 m offset, so this is the
       height the CAD assembly had it at. The laser frame must sit at the real
       scanner centre, since that is where the scan originates. -->
  <origin xyz="0 0 0.157" rpy="0 0 1.5708 "/>
  <parent link="base_link"/>
  <child link="laser"/>
</joint>

<joint name="left_wheel_joint" type="continuous">
  <origin xyz="0.12 0 0.0317" rpy="0 1.5708 1.5708"/>
  <parent link="base_link"/>
  <child link="left_wheel_1"/>
  <axis xyz="0.0 -1.0 0.0"/>
</joint>

<joint name="right_wheel_joint" type="continuous">
  <origin xyz="-0.12 0 0.0317" rpy="0 1.5708 1.5708"/>
  <parent link="base_link"/>
  <child link="right_wheel_1"/>
  <axis xyz="0.0 -1.0 0.0"/>
</joint>

</robot>
