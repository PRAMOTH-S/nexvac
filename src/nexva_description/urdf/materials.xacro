<?xml version="1.0" ?>
<robot name="robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Silver -->
  <material name="silver">
    <color rgba="0.700 0.700 0.700 1.000"/>
  </material>

  <!-- Red -->
  <material name="red">
    <color rgba="1.000 0.000 0.000 1.000"/>
  </material>

  <!-- Green -->
  <material name="green">
    <color rgba="0.000 1.000 0.000 1.000"/>
  </material>

  <!-- Blue -->
  <material name="blue">
    <color rgba="0.000 0.200 1.000 1.000"/>
  </material>

  <!-- Yellow -->
  <material name="yellow">
    <color rgba="1.000 1.000 0.000 1.000"/>
  </material>

  <!-- Orange -->
  <material name="orange">
    <color rgba="1.000 0.500 0.000 1.000"/>
  </material>

  <!-- Purple -->
  <material name="purple">
    <color rgba="0.600 0.000 0.800 1.000"/>
  </material>

  <!-- Cyan -->
  <material name="cyan">
    <color rgba="0.000 1.000 1.000 1.000"/>
  </material>

  <!-- White -->
  <material name="white">
    <color rgba="1.000 1.000 1.000 1.000"/>
  </material>

  <!-- Black -->
  <material name="black">
    <color rgba="0.000 0.000 0.000 1.000"/>
  </material>

  <!-- Dark Gray -->
  <material name="dark_gray">
    <color rgba="0.150 0.150 0.150 1.000"/>
  </material>

  <!-- Light Gray -->
  <material name="light_gray">
    <color rgba="0.800 0.800 0.800 1.000"/>
  </material>

  <!-- Brown -->
  <material name="brown">
    <color rgba="0.500 0.250 0.100 1.000"/>
  </material>

  <!-- Pink -->
  <material name="pink">
    <color rgba="1.000 0.200 0.600 1.000"/>
  </material>

</robot>